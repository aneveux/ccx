<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.neveux</groupId>
    <artifactId>ccx</artifactId>
    <version>${revision}${changelist}</version>
    <packaging>jar</packaging>

    <name>ccx</name>
    <description>CLI for managing fine-grained Claude Code configuration per project</description>
    <url>https://github.com/aneveux/ccx</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>aneveux</id>
            <name>Antoine Neveux</name>
            <email>antoine@neveux.me</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/aneveux/ccx.git</connection>
        <developerConnection>scm:git:https://github.com/aneveux/ccx.git</developerConnection>
        <url>https://github.com/aneveux/ccx</url>
    </scm>

    <properties>
        <!-- CI-friendly version — the git-changelist-maven-extension rewrites ${changelist}
             to -rc<commitcount>.<sha> when built with -Dset.changelist (see .mvn/). A plain
             local build resolves to ${revision}${changelist} = <revision>-SNAPSHOT. -->
        <revision>0.6.0</revision>
        <changelist>-SNAPSHOT</changelist>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.platform.version>3.39.4</quarkus.platform.version>
        <picocli.version>4.7.7</picocli.version>
        <tamboui.version>0.5.0</tamboui.version>
        <jline.version>3.25.1</jline.version>
        <jansi.version>2.4.3</jansi.version>
        <assertj.version>3.27.7</assertj.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <jreleaser.version>1.26.0</jreleaser.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>dev.tamboui</groupId>
                <artifactId>tamboui-bom</artifactId>
                <version>${tamboui.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Frozen at 3.25.1, the version tamboui 0.4.0 is built against. Quarkus 3.39's
                 BOM would bring 4.x, but no version above 3.25.1 builds: GraalVM 25's
                 points-to analysis dies inside org.jline.terminal.impl.ffm.CLibrary on the
                 `linkToNative` polymorphic signature. Confirmed on 4.2.1, 4.3.1 and 3.30.16,
                 so this is not a major-version boundary. .github/dependabot.yml ignores the
                 dependency outright for the same reason. -->
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline</artifactId>
                <version>${jline.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Picocli CLI framework wired into Quarkus (arg parsing, subcommand routing, IFactory CDI beans) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-picocli</artifactId>
        </dependency>
        <!-- CDI container (dependency injection for services and commands) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- YAML deserialization for profile.yaml profile definitions -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <!-- JSON (de)serialization for settings.json, context.json, and plugin-map cache -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Jackson java.time support for profile-enable timestamps in context.json -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Tamboui TUI core — full-screen dashboard rendering and event loop -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-tui</artifactId>
        </dependency>
        <!-- Tamboui/picocli bridge for launching the TUI from a picocli command -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-picocli</artifactId>
        </dependency>
        <!-- JLine3 terminal backend driving Tamboui raw-mode I/O -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-jline3-backend</artifactId>
        </dependency>
        <!-- Markdown rendering for TUI preview panes -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-markdown</artifactId>
        </dependency>
        <!-- Tamboui higher-level widget and layout helpers -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-toolkit</artifactId>
        </dependency>

        <!-- Three different pinning styles below, on purpose:
             - jline is pinned in <dependencyManagement> because it is transitive (tamboui pulls it
               in) — only dependencyManagement overrides a version this project never declares.
             - jansi carries an inline <version> because it is a direct dependency here and no BOM
               in scope manages it; a property + inline version is the whole pin.
             - jna has no version at all: the Quarkus BOM manages it, and it is the version the
               native build was verified against. Do not pin it — that would silently diverge from
               the platform on the next Quarkus bump. -->
        <!-- JNA stubs so GraalVM native-image can parse JLine's bundled native providers -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
        </dependency>
        <!-- Jansi stubs for the same native-image JLine parsing path -->
        <dependency>
            <groupId>org.fusesource.jansi</groupId>
            <artifactId>jansi</artifactId>
            <version>${jansi.version}</version>
        </dependency>

        <!-- Test -->
        <!-- JUnit 5 test harness with Quarkus lifecycle (@QuarkusTest, QuarkusMock) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Fluent test assertions (not in Quarkus BOM — pinned explicitly) -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${maven-failsafe-plugin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <systemPropertyVariables>
                                        <native.image.path>${project.build.directory}/ccx</native.image.path>
                                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                                        <maven.home>${maven.home}</maven.home>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jreleaser</groupId>
                        <artifactId>jreleaser-maven-plugin</artifactId>
                        <version>${jreleaser.version}</version>
                        <configuration>
                            <jreleaser>
                                <project>
                                    <name>ccx</name>
                                    <description>CLI for managing fine-grained Claude Code configuration per project</description>
                                    <copyright>2026 Antoine Neveux</copyright>
                                    <license>MIT</license>
                                    <links>
                                        <homepage>https://github.com/aneveux/ccx</homepage>
                                    </links>
                                    <authors>
                                        <author>Antoine Neveux</author>
                                    </authors>
                                </project>
                                <release>
                                    <github>
                                        <owner>aneveux</owner>
                                        <name>ccx</name>
                                        <branch>master</branch>
                                        <milestone>
                                            <close>false</close>
                                        </milestone>
                                        <changelog>
                                            <preset>gitmoji</preset>
                                            <formatted>ALWAYS</formatted>
                                            <format>- {{commitShortHash}} {{commitTitle}}</format>
                                            <contributors>
                                                <enabled>false</enabled>
                                            </contributors>
                                        </changelog>
                                    </github>
                                </release>
                                <distributions>
                                    <ccx>
                                        <type>NATIVE_IMAGE</type>
                                        <artifacts>
                                            <artifact>
                                                <path>{{basedir}}/target/ccx</path>
                                                <platform>linux-x86_64</platform>
                                            </artifact>
                                        </artifacts>
                                    </ccx>
                                </distributions>
                            </jreleaser>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
